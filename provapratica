create table aeronaves(
	id serial primary key,
	modelo varchar(100) not null,
	codigo_cauda varchar(10) unique not null,
	capacidade int not null CHECK(capacidade >= 0)
);

create table pilotos(
	id serial primary key,
	nome varchar(100) unique,
	codigo_anac varchar(6) unique not null,
	horas_voo int default 0 check(horas_voo >=0)
);

create table voos(
	id serial primary key,
	numero_voo varchar(100) not null,
	origem varchar(100) not null,
	destino varchar(100) not null,
	data_hora default current_timestamp,
	status varchar(100) default
);


create table voos(
	id serial primary key,
	aeronave_id int not null,
	piloto_id int not null,
	numero_voo varchar(100) not null,
	origem varchar(100) not null,
	destino varchar(100) not null,
	data_hora timestamp default CURRENT_TIMESTAMP,
	status varchar(100) default 'Agendado' check(status in('Agendado', 'Em Voo', 'Concluido', 'Cancelado')),


	constraint fk_aeronave_id
	foreign key (aeronave_id)
	references aeronaves(id),

	constraint fk_piloto_id
	foreign key (piloto_id)
	references pilotos(id)

	
	
);

create table passageiros(
	id serial primary key,
	nome varchar(100) not null,
	cpf varchar(11) unique not null,
	email varchar(100) unique not null
);

create table passagens(
	id serial primary key,
	voo_id int not null,
	passageiro_id int not null,
	assento varchar(4) not null,
	classe varchar(100) default 'Economica' check(classe in ('Economica', 'Executiva')),

	constraint fk_voo_id
	foreign key (voo_id)
	references voos(id),

	constraint fk_passageiro_id
	foreign key (passageiro_id)
	references passageiros(id)
);




